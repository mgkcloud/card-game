{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": false,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "*.ts",
    "globals.d.ts"
  ]
}
